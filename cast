#!/usr/bin/env python3
"""Miracast (Wi-Fi Display) sender for the Display panel.

  cast scan                      JSON list of Miracast TVs nearby
  cast start <mac> <mirror|extend>  cast the focused screen, or a new screen CAST-1
  cast stop                      end the cast

start runs as the transient user unit omarchy-cast, so the panel and stop can find it.
"""
import json, os, re, secrets, signal, socket, subprocess, sys, time

NM = "org.freedesktop.NetworkManager"
CON = "omarchy-cast"
OUTPUT = "CAST-1"
UNIT = "omarchy-cast"
STATUS = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "omarchy-cast.json")
# WFD device info: source, available for a session, RTSP on 7236, 200 Mbps.
WFD_IES = "00:00:06:00:90:1c:44:00:c8"
RTSP_PORT = 7236
# CEA bit -> (width, height, fps), best first.
CEA = [(8, 1920, 1080, 60), (7, 1920, 1080, 30), (6, 1280, 720, 60), (5, 1280, 720, 30), (0, 640, 480, 60)]


def busctl(*args):
    out = subprocess.run(["busctl", "--json=short", *args], capture_output=True, text=True, check=True).stdout
    return json.loads(out) if out.strip() else None


def p2p_iface():
    devices = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], capture_output=True, text=True).stdout
    return next((d.split(":")[0] for d in devices.splitlines() if d.endswith(":wifi-p2p")), None) or sys.exit("no Wi-Fi Direct device")


def p2p_device():
    return busctl("call", NM, "/org/freedesktop/NetworkManager", NM, "GetDeviceByIpIface", "s", p2p_iface())["data"][0]


def is_sink(ies):
    # Subelement 0 is device information; its low two bits say source (0) or sink (1-3).
    return len(ies) >= 5 and ies[0] == 0 and (ies[4] & 3) != 0


def inches_of(name):
    m = re.search(r"\b(\d{2,3})\b", name)
    return int(m.group(1)) if m and 20 <= int(m.group(1)) <= 120 else 0


def tvs():
    dev = p2p_device()
    found = []
    for path in busctl("get-property", NM, dev, NM + ".Device.WifiP2P", "Peers")["data"]:
        p = busctl("call", NM, path, "org.freedesktop.DBus.Properties", "GetAll", "s", NM + ".WifiP2PPeer")["data"][0]
        if is_sink(p["WfdIEs"]["data"]):
            name = p["Name"]["data"].strip()
            found.append({"name": name, "mac": p["HwAddress"]["data"], "strength": p["Strength"]["data"], "inches": inches_of(name)})
    return sorted(found, key=lambda t: -t["strength"])


def scan():
    try:
        busctl("call", NM, p2p_device(), NM + ".Device.WifiP2P", "StartFind", "a{sv}", "1", "timeout", "i", "30")
    except subprocess.CalledProcessError:
        pass  # already searching
    print(json.dumps(tvs()))


# ---------- RTSP (WFD session control) ----------

def parse_params(body):
    return dict(line.split(":", 1) for line in body.replace("\r", "").split("\n") if ":" in line)


def choose_format(params):
    """Pick video, audio and RTP port from the sink's M3 reply."""
    chunks = [c.split() for c in params.get("wfd_video_formats", "").split(",")]
    codecs = [chunks[0][2:]] + chunks[1:] if chunks and len(chunks[0]) > 4 else []
    codecs = [c for c in codecs if len(c) >= 3]
    if not codecs:
        raise RuntimeError("TV sent no video formats")
    codec = max(codecs, key=lambda c: (int(c[0], 16) == 1, int(c[1], 16)))  # constrained baseline, highest level
    cea = int(codec[2], 16)
    bit, w, h, fps = next(r for r in CEA if cea >> r[0] & 1 or r[0] == 0)
    video = f"00 00 01 {codec[1]} {1 << bit:08X} 00000000 00000000 00 0000 0000 00 none none"
    aac = "AAC" in params.get("wfd_audio_codecs", "")
    port = int(params.get("wfd_client_rtp_ports", "").split()[1])
    return {"video": video, "audio": "AAC 00000001 00" if aac else "none", "aac": aac, "port": port,
            "width": w, "height": h, "fps": fps}


class Rtsp:
    def __init__(self, sock):
        self.sock, self.buf, self.cseq = sock, b"", 0

    def read(self):
        while b"\r\n\r\n" not in self.buf:
            data = self.sock.recv(4096)
            if not data:
                raise ConnectionError("TV closed the connection")
            self.buf += data
        head, self.buf = self.buf.split(b"\r\n\r\n", 1)
        lines = head.decode(errors="replace").split("\r\n")
        headers = {k.strip().lower(): v.strip() for k, v in (l.split(":", 1) for l in lines[1:] if ":" in l)}
        size = int(headers.get("content-length", 0))
        while len(self.buf) < size:
            data = self.sock.recv(4096)
            if not data:
                raise ConnectionError("TV closed the connection")
            self.buf += data
        body, self.buf = self.buf[:size].decode(errors="replace"), self.buf[size:]
        return lines[0], headers, body

    def send(self, start, headers, body=""):
        if body:
            headers = {**headers, "Content-Type": "text/parameters", "Content-Length": str(len(body))}
        msg = start + "\r\n" + "".join(f"{k}: {v}\r\n" for k, v in headers.items()) + "\r\n" + body
        self.sock.sendall(msg.encode())

    def request(self, method, body="", url="rtsp://localhost/wfd1.0", extra=None, wait=None):
        self.cseq += 1
        self.send(f"{method} {url} RTSP/1.0", {"CSeq": self.cseq, **(extra or {})}, body)
        while wait:
            start, headers, rbody = self.read()
            if not start.startswith("RTSP/"):
                wait(start, headers, rbody)
            elif headers.get("cseq") == str(self.cseq):
                if " 200 " not in start + " ":
                    raise RuntimeError(f"TV refused {method}: {start}")
                return rbody

    def reply(self, headers, extra=None):
        self.send("RTSP/1.0 200 OK", {"CSeq": headers.get("cseq", "0"), **(extra or {})})


# ---------- session ----------

def status(**fields):
    with open(STATUS + ".tmp", "w") as f:
        json.dump(fields, f)
    os.replace(STATUS + ".tmp", STATUS)


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def recorder(output, sink_ip, fmt):
    cmd = ["wf-recorder", "-o", output, "-c", "h264_vaapi", "-d", "/dev/dri/renderD128", "-r", str(fmt["fps"]),
           "-F", f"scale_vaapi=w={fmt['width']}:h={fmt['height']}:format=nv12",
           "-p", "profile=constrained_baseline", "-p", f"g={fmt['fps']}", "-p", "bf=0", "-p", "b=8M",
           "-m", "rtp_mpegts", "-f", f"rtp://{sink_ip}:{fmt['port']}?pkt_size=1328", "-y"]
    if fmt["aac"]:
        sink = run("pactl", "get-default-sink").stdout.strip()
        cmd += ["-a", sink + ".monitor", "-C", "aac", "-R", "48000"]
    return subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def start(mac, mode):
    tv = next((t for t in tvs() if t["mac"].lower() == mac.lower()), None)
    if not tv:
        sys.exit(f"no Miracast TV {mac} nearby")
    output = OUTPUT if mode == "extend" else next(m["name"] for m in json.loads(run("hyprctl", "monitors", "-j").stdout) if m["focused"])
    info = {"name": tv["name"], "mac": mac, "mode": mode, "output": output, "inches": tv["inches"]}
    status(**info, state="connecting")
    rec = None

    def cleanup(*_, code=0):
        if rec:
            rec.terminate()
        run("nmcli", "connection", "delete", CON)
        if mode == "extend":
            run("hyprctl", "output", "remove", OUTPUT)
        if os.path.exists(STATUS):
            os.remove(STATUS)
        sys.exit(code)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    try:
        if mode == "extend":
            run("hyprctl", "output", "create", "headless", OUTPUT)
        server = socket.create_server(("0.0.0.0", RTSP_PORT), reuse_port=True)
        server.settimeout(60)
        run("nmcli", "connection", "delete", CON)
        add = run("nmcli", "connection", "add", "type", "wifi-p2p", "con-name", CON, "ifname", p2p_iface(),
                  "wifi-p2p.peer", mac, "wifi-p2p.wfd-ies", WFD_IES, "ipv4.method", "auto", "ipv6.method", "auto",
                  "connection.autoconnect", "no")
        if add.returncode:
            raise RuntimeError(add.stderr.strip())
        # The TV may ask to allow the connection first.
        up = run("nmcli", "--wait", "120", "connection", "up", CON)
        if up.returncode:
            raise RuntimeError("TV did not accept: " + up.stderr.strip())
        conn, (sink_ip, _) = server.accept()
        rtsp = Rtsp(conn)
        session = secrets.token_hex(8)
        stream = {}

        def handle(start_line, headers, body):
            method = start_line.split()[0]
            if method == "OPTIONS":
                rtsp.reply(headers, {"Public": "org.wfa.wfd1.0, SETUP, TEARDOWN, PLAY, PAUSE, GET_PARAMETER, SET_PARAMETER"})
            elif method == "SETUP":
                rtsp.reply(headers, {"Session": session, "Transport": headers.get("transport", "") + ";server_port=5004-5005"})
            elif method == "PLAY":
                rtsp.reply(headers, {"Session": session})
                stream["play"] = True
            elif method == "TEARDOWN":
                rtsp.reply(headers)
                raise ConnectionError("TV ended the cast")
            else:  # GET_PARAMETER keep-alive, SET_PARAMETER wfd_idr_request: key frames come every second anyway
                rtsp.reply(headers)

        rtsp.request("OPTIONS", url="*", extra={"Require": "org.wfa.wfd1.0"}, wait=handle)  # M1, answers M2 meanwhile
        fmt = choose_format(parse_params(rtsp.request(
            "GET_PARAMETER", "wfd_video_formats\r\nwfd_audio_codecs\r\nwfd_client_rtp_ports\r\n", wait=handle)))  # M3
        local_ip = conn.getsockname()[0]
        rtsp.request("SET_PARAMETER", wait=handle, body=(  # M4
            f"wfd_video_formats: {fmt['video']}\r\nwfd_audio_codecs: {fmt['audio']}\r\n"
            f"wfd_presentation_URL: rtsp://{local_ip}/wfd1.0/streamid=0 none\r\n"
            f"wfd_client_rtp_ports: RTP/AVP/UDP;unicast {fmt['port']} 0 mode=play\r\n"))
        rtsp.request("SET_PARAMETER", "wfd_trigger_method: SETUP\r\n", wait=handle)  # M5, then the TV sends SETUP and PLAY
        conn.settimeout(25)
        while True:
            if stream.get("play") and not rec:
                rec = recorder(output, sink_ip, fmt)
                status(**info, state="casting")
            try:
                msg = rtsp.read()
                if not msg[0].startswith("RTSP/"):  # replies to our keep-alives need no answer
                    handle(*msg)
            except socket.timeout:
                rtsp.request("GET_PARAMETER", extra={"Session": session})  # keep-alive, answered in the loop
            if rec and rec.poll() is not None:
                raise RuntimeError("screen capture stopped")
    except Exception as e:
        print(f"cast: {e}", file=sys.stderr)
        cleanup(code=1)


def main():
    cmd = sys.argv[1:] or ["scan"]
    if cmd[0] == "scan":
        scan()
    elif cmd[0] == "start" and len(cmd) == 3 and re.fullmatch(r"([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", cmd[1]) and cmd[2] in ("mirror", "extend"):
        if os.environ.get("INVOCATION_ID"):
            start(cmd[1], cmd[2])
        else:  # run under systemd so it outlives the panel and `cast stop` can end it
            run("systemctl", "--user", "stop", UNIT)
            sys.exit(run("systemd-run", "--user", "--collect", f"--unit={UNIT}", os.path.realpath(__file__), *cmd).returncode)
    elif cmd[0] == "stop":
        run("systemctl", "--user", "stop", UNIT)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
