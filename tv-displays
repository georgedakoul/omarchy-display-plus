#!/bin/bash
# Rotate and place every Hyprland display, and add virtual TV screens that
# Sunshine streams over Tailscale to Moonlight on the TV.
#
#   tv-displays state                  JSON for the bar panel
#   tv-displays rotate <output> <0-3>  Hyprland transform (1 = 90°, 2 = 180°, 3 = 270°)
#   tv-displays place <output> <auto|auto-left|auto-right|auto-up|auto-down>
#   tv-displays arrange <output>=<x>x<y>...  pin positions, as dragged on the map
#   tv-displays size <n> <inches>      the TV's real size, for the map
#   tv-displays add                    new TV-n stream; its screen appears once a device pairs
#   tv-displays remove <n>             delete TV-n, its stream and its firewall rules
#   tv-displays pair <n>               open TV-n's Sunshine page to enter the Moonlight PIN
#   tv-displays restore                recreate the TVs at login and after (un)pairing

set -euo pipefail

STATE="$HOME/.config/omarchy/tv-displays.json"

# One change at a time: two overlapping runs race on the state file and on ufw's lock.
[[ ${1:-} == state ]] || { exec 9>"${XDG_RUNTIME_DIR:-/tmp}/tv-displays.lock"; flock 9; }
LUA="$HOME/.config/hypr/displays.lua"
SUN="$HOME/.config/sunshine"
UNIT_FILE="$HOME/.config/systemd/user/sunshine-tv@.service"
PATH_UNIT="$HOME/.config/systemd/user/sunshine-tv-paired@.path"
TV_MODE="1920x1080@120" # Sunshine paces frames best when the output runs at twice the stream's 60fps

[[ -f $STATE ]] || echo '{"outputs":{},"tvs":[]}' >"$STATE"

port_of() { echo $((47989 + 100 * $1)); }

save() { jq "$@" "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"; }

valid_output() { hyprctl monitors all -j | jq -e --arg n "$1" 'any(.[]; .name == $n)' >/dev/null; }

has_sunshine() { command -v sunshine >/dev/null; }

paired() { jq -e '(.root.named_devices // []) | length > 0' "$SUN/tv-$1/state.json" >/dev/null 2>&1; }

# Rewrite the Hyprland rules from the state file, then apply them.
write_lua() {
  local monitors
  monitors=$(hyprctl monitors all -j)
  {
    echo "-- Generated by the TV displays bar widget. Edit from the bar, not by hand."
    jq -r --argjson live "$monitors" --arg tv_mode "$TV_MODE" '
      .outputs | to_entries[] | .key as $name
      | ($name | test("^TV-[0-9]+$")) as $tv
      | ([$live[] | select(.name == $name) | .scale][0] // 1) as $scale
      | "hl.monitor({ output = \"\($name)\", mode = \"\(if $tv then $tv_mode else "preferred" end)\", position = \"\(.value.position // "auto")\", scale = \(if $tv then 1 else $scale end), transform = \(.value.transform // 0) })"
    ' "$STATE"
  } >"$LUA"
  hyprctl reload >/dev/null
}

# Open or close a TV's Moonlight ports on the Tailscale interface only.
firewall() {
  local action=$1 base=$2 port
  command -v ufw >/dev/null || return 0
  if ! sudo -n true 2>/dev/null; then
    echo "sudo needs a password; open ports $((base - 5))-$((base + 21)) on tailscale0 yourself" >&2
    return 0
  fi
  local verb=(allow in on tailscale0 to any port) note=(comment omarchy-tv-displays)
  [[ $action == delete ]] && verb=(delete "${verb[@]}") note=()
  for port in $((base - 5)) "$base" $((base + 21)); do
    sudo -n ufw "${verb[@]}" "$port" proto tcp "${note[@]}" >/dev/null 2>&1 || true
  done
  for port in $((base + 9)) $((base + 10)) $((base + 11)) $((base + 13)) $((base + 21)); do
    sudo -n ufw "${verb[@]}" "$port" proto udp "${note[@]}" >/dev/null 2>&1 || true
  done
}

write_sunshine_conf() {
  local n=$1 dir="$SUN/tv-$1"
  mkdir -p "$dir" "$(dirname "$UNIT_FILE")"
  cat >"$dir/sunshine.conf" <<EOF
sunshine_name = $(hostname) TV-$n
port = $(port_of "$n")
output_name = TV-$n
capture = wlr
file_state = $dir/state.json
credentials_file = $dir/credentials.json
log_path = $dir/sunshine.log
EOF
  if [[ ! -f $UNIT_FILE ]]; then
    cat >"$UNIT_FILE" <<'EOF'
[Unit]
Description=Sunshine stream for virtual display TV-%i

[Service]
ExecStart=/usr/bin/sunshine %h/.config/sunshine/tv-%i/sunshine.conf
Restart=on-failure
RestartSec=3
EOF
    systemctl --user daemon-reload
  fi
  if [[ ! -f $PATH_UNIT ]]; then
    # Sunshine rewrites state.json on every pair and unpair: show or hide the TV screen then.
    cat >"$PATH_UNIT" <<'EOF'
[Unit]
Description=Show TV-%i in the displays while a device is paired

[Path]
PathChanged=%h/.config/sunshine/tv-%i/state.json
EOF
    cat >"${PATH_UNIT%.path}.service" <<EOF
[Unit]
Description=Show TV-%i in the displays while a device is paired

[Service]
Type=oneshot
ExecStart=$(realpath "$0") restore
EOF
    systemctl --user daemon-reload
  fi
}

start_tv() {
  local n=$1 exists=false
  valid_output "TV-$n" && exists=true
  # The screen exists only while a device is paired, so an unwatched TV never takes the cursor or windows.
  if paired "$n"; then
    $exists || hyprctl output create headless "TV-$n" >/dev/null
  else
    ! $exists || hyprctl output remove "TV-$n" >/dev/null
  fi
  if has_sunshine; then
    [[ -f $SUN/tv-$n/sunshine.conf && -f $PATH_UNIT ]] || write_sunshine_conf "$n"
    systemctl --user start "sunshine-tv@$n" "sunshine-tv-paired@$n.path"
  fi
}

case "${1:-state}" in
state)
  tvs="[]"
  for n in $(jq -r '.tvs[]' "$STATE"); do
    active=$(systemctl --user is-active "sunshine-tv@$n" 2>/dev/null || true)
    tvs=$(jq -c --argjson n "$n" --argjson port "$(port_of "$n")" --arg active "$active" \
      --argjson paired "$(paired "$n" && echo true || echo false)" \
      '. + [{n: $n, name: "TV-\($n)", port: $port, streaming: ($active == "active"), paired: $paired}]' <<<"$tvs")
  done
  hyprctl monitors all -j | jq -c \
    --slurpfile s "$STATE" --argjson tvs "$tvs" \
    --arg ip "$(tailscale ip -4 2>/dev/null | head -1 || true)" \
    --argjson sunshine "$(has_sunshine && echo true || echo false)" \
    --argjson cast "$(cat "${XDG_RUNTIME_DIR:-/run/user/$UID}/omarchy-cast.json" 2>/dev/null || echo null)" '
    { sunshine: $sunshine, ip: $ip, tvs: $tvs, cast: $cast,
      displays: map({ name, description, width, height, transform, focused, x, y, scale,
        physicalWidth, physicalHeight, inches: ($s[0].outputs[.name].inches // (if .name == "CAST-1" then $cast.inches // 0 else 0 end)),
        enabled: (.disabled | not),
        position: ($s[0].outputs[.name].position // "auto"),
        tv: (.name | test("^(TV|CAST)-[0-9]+$")) }) }'
  ;;
rotate)
  [[ ${3:-} =~ ^[0-3]$ ]] && valid_output "${2:-}" || { echo "usage: rotate <output> <0-3>" >&2; exit 1; }
  save --arg o "$2" --argjson t "$3" '.outputs[$o].transform = $t'
  write_lua
  ;;
place)
  [[ ${3:-} =~ ^auto(-left|-right|-up|-down)?$ ]] && valid_output "${2:-}" ||
    { echo "usage: place <output> <auto|auto-left|auto-right|auto-up|auto-down>" >&2; exit 1; }
  save --arg o "$2" --arg p "$3" '.outputs[$o].position = $p'
  write_lua
  ;;
arrange)
  shift
  for pair in "$@"; do
    [[ $pair =~ ^([A-Za-z0-9-]+)=(-?[0-9]+x-?[0-9]+)$ ]] && valid_output "${BASH_REMATCH[1]}" ||
      { echo "usage: arrange <output>=<x>x<y>..." >&2; exit 1; }
  done
  for pair in "$@"; do save --arg o "${pair%%=*}" --arg p "${pair#*=}" '.outputs[$o].position = $p'; done
  write_lua
  ;;
size)
  [[ ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[0-9]+$ ]] && ((${3} >= 10 && ${3} <= 120)) ||
    { echo "usage: size <n> <10-120>" >&2; exit 1; }
  jq -e --argjson n "$2" '.tvs | index($n)' "$STATE" >/dev/null || { echo "no TV-$2" >&2; exit 1; }
  save --arg o "TV-$2" --argjson i "$3" '.outputs[$o].inches = $i'
  ;;
add)
  n=1
  while jq -e --argjson n "$n" '.tvs | index($n)' "$STATE" >/dev/null; do n=$((n + 1)); done
  save --argjson n "$n" '.tvs += [$n] | .outputs["TV-\($n)"] = {position: "auto-right", transform: 0, inches: 55}'
  write_lua
  firewall allow "$(port_of "$n")"
  start_tv "$n"
  echo "TV-$n"
  ;;
remove)
  n=${2:-}
  [[ $n =~ ^[0-9]+$ ]] || { echo "usage: remove <n>" >&2; exit 1; }
  systemctl --user stop "sunshine-tv-paired@$n.path" "sunshine-tv@$n" 2>/dev/null || true
  hyprctl output remove "TV-$n" >/dev/null || true
  firewall delete "$(port_of "$n")"
  rm -rf "${SUN:?}/tv-$n"
  save --argjson n "$n" '.tvs -= [$n] | del(.outputs["TV-\($n)"])'
  write_lua
  ;;
pair)
  [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "usage: pair <n>" >&2; exit 1; }
  systemctl --user is-active -q "sunshine-tv@$2" || start_tv "$2"
  # Sunshine's own admin page, opened on this desktop like Omarchy's Sunshine Admin app.
  omarchy-launch-webapp "https://localhost:$(($(port_of "$2") + 1))" --ignore-certificate-errors >/dev/null 2>&1 &
  ;;
restore)
  for n in $(jq -r '.tvs[]' "$STATE"); do start_tv "$n"; done
  ;;
*)
  sed -n '2,13p' "$0" >&2
  exit 1
  ;;
esac
